# Copy to `.env.production` ON THE SERVER and fill in. Never commit the real file.
#
# Pull the current values out of Netlify (Site settings → Environment variables)
# BEFORE the account lapses — once it's gone you lose the only copy of several
# of these. Do this first, today.
#
#   chmod 600 .env.production

# ── Supabase — unchanged by the migration, same project as today ───────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Some server modules read SUPABASE_URL (no NEXT_PUBLIC_ prefix); set both.
SUPABASE_URL=

# ── App identity ───────────────────────────────────────────────────────────
# MUST be the new production origin, e.g. https://opinions.ng
# Squad's card checkout builds its callback URL from this — if it still points
# at the old Netlify domain, users get redirected to a dead host after paying.
NEXT_PUBLIC_APP_URL=

# ── Secrets ────────────────────────────────────────────────────────────────
ADMIN_SECRET=
CRON_SECRET=
# Deploy webhook secret (was NETLIFY_DEPLOY_SECRET). NETLIFY_DEPLOY_SECRET is
# still accepted as a fallback so nothing breaks mid-cutover.
DEPLOY_SECRET=

# ── Payments ───────────────────────────────────────────────────────────────
SQUAD_SECRET_KEY=
# Live: https://api-d.squadco.com   Sandbox: https://sandbox-api-d.squadco.com
SQUAD_BASE_URL=
PAYSTACK_SECRET_KEY=

# ── Email / SMS ────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=
OPS_EMAIL=
TERMII_API_KEY=
TERMII_SENDER_ID=

# ── Sports data ────────────────────────────────────────────────────────────
THE_ODDS_API_KEY=
FOOTBALL_DATA_API_KEY=
API_SPORTS_KEY=
PANDASCORE_API_KEY=
STATSAPI_KEY=

# ── AI (mechanic triage) ───────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Web3 (optional — only if those features are live) ──────────────────────
NEXT_PUBLIC_WALLET_CONNECT_ID=
NEXT_PUBLIC_ALCHEMY_KEY=
NEXT_PUBLIC_TRUTH_MARKET_ADDRESS=
NEXT_PUBLIC_PAYMASTER_URL=
NEXT_PUBLIC_ENABLE_PHONE_AUTH=

# ── AWS (Phase 3 KMS heartbeat — leave blank until that ships) ─────────────
AWS_REGION=
AWS_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Social pipeline: X (Twitter) ───────────────────────────────────────────
# From developer.x.com → your Project → Keys and tokens.
# The access token/secret pair must be regenerated AFTER you set the app
# to "Read and write" — a token minted under read-only permissions keeps
# 403ing on posts and the error does not say why.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ── Social pipeline: budget guard ──────────────────────────────────────────
# X moved to metered pay-per-use in Feb 2026: $0.015 per post, $0.20 per
# post CONTAINING A LINK, $0.005 per post read. Unattended cron on a
# metered API is how a bug becomes a bill, so this cap is enforced in
# code before every billable call.
#
# Set BELOW what you actually funded. The ledger is an estimate built
# from X's published rate card, not a copy of their billing — leaving
# ~10% headroom means our guard stops first, cleanly and with a Telegram
# message, rather than X's credits running dry mid-post. $4.50 against
# $5.00 funded.
#
# Also set a spend cap in the X developer portal. This keeps you away
# from that cap; the portal cap is what saves you if this has a bug.
SOCIAL_MONTHLY_BUDGET_USD=4.50
NGN_PER_USD=1550

# Posts per day. Four slots exist (07:00/12:00/17:00/20:00 UTC), so 4 is
# the ceiling. 3 x 30 days x $0.015 = $1.35/month, which leaves room
# under a $4.50 cap; 4/day is $1.80 and gets tight.
#
# Overridable at runtime with /cap N in Telegram — that wins over this.
SOCIAL_DAILY_POST_CAP=3

# Reads per scan run. Only used if you re-enable the metered scanner in
# cron-social-scan.yml — reply discovery is share-to-bot by default, so
# this normally does nothing. Each target poll costs $0.025.
SOCIAL_MAX_READS_PER_RUN=15

# How this container reaches ITSELF, for fetching its own card images.
# Leave blank to use http://127.0.0.1:3000 — correct for the single-box
# Docker setup. Going out via the public URL instead would mean a full
# TLS round trip through Caddy back into this same container, which is
# slow, fails while Caddy restarts mid-deploy, and hangs outright on AWS
# networks without hairpin NAT.
INTERNAL_APP_URL=

# ── Social pipeline: Telegram approval bot ─────────────────────────────────
# TELEGRAM_BOT_TOKEN  — from @BotFather
# TELEGRAM_CHAT_ID    — your own numeric id, from @userinfobot
# TELEGRAM_WEBHOOK_SECRET — any long random string; Telegram echoes it
#   back on every delivery and /api/social/telegram rejects anything else
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
